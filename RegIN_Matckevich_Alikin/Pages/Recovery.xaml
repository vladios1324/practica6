<Page x:Class="RegIN_Matckevich_Alikin.Pages.Recovery"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegIN_Matckevich_Alikin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Recovery"
      xmlns:uc="clr-namespace:RegIN_Matckevich_Alikin.Elements"
      Background="White"
      FontFamily="Segoe UI"
      FontSize="13">

    <Grid>
        <Border
            Height="345"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="308"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Image
                    x:Name="IUser"
                    HorizontalAlignment="Center"
                    Height="100"
                    Margin="32"
                    VerticalAlignment="Top"
                    Width="100"
                    Source="/RegIN_Matckevich_Alikin;component/Images/ic-user.png">
                    <Image.Clip>
                        <EllipseGeometry
                            RadiusX="50"
                            RadiusY="50"
                            Center="50, 50"/>
                    </Image.Clip>
                </Image>

                <Label
                    x:Name="LNameUser"
                    Margin="10,137,10,0"
                    HorizontalContentAlignment="Center"
                    Content=""
                    VerticalAlignment="Top"/>

                <Label
                    Content="Enter login:"
                    Margin="10,161,10,0"
                    VerticalAlignment="Top"/>

                <TextBox
                    x:Name="TbLogin"
                    Height="23" Margin="10,185,10,0"
                    TextWrapping="Wrap"
                    Text=""
                    VerticalAlignment="Top"
                    KeyUp="SetLogin"
                    LostFocus="SetLogin"/>

                <uc:ElementCapture
                    x:Name="Capture"
                    HorizontalAlignment="Center"
                    Width="280"
                    Margin="10,213,18,0"
                    Height="100"
                    VerticalAlignment="Top"/>

                <Label
                    Content="Back"
                    Margin="10,318,10,0"
                    VerticalAlignment="Top"
                    Foreground="#FF673AB7"
                    FontSize="10"
                    MouseDown="OpenLogin"
                    HorizontalAlignment="Left"
                    Width="50"
                    Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Page>