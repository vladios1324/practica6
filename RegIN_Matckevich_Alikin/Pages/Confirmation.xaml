<Page x:Class="RegIN_Matckevich_Alikin.Pages.Confirmation"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegIN_Matckevich_Alikin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="710"
      Title="Confirmation"
      Background="White"
      FontFamily="Segoe UI"
      FontSize="13">

    <Grid>
        <Border
            Height="304"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Width="307"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Image
                    HorizontalAlignment="Center"
                    Height="100"
                    Margin="32"
                    VerticalAlignment="Top"
                    Width="100"
                    Source="/Images/ic-email.png">
                    <Image.Clip>
                        <EllipseGeometry
                            RadiusX="50"
                            RadiusY="50"
                            Center="50, 50"/>
                    </Image.Clip>
                </Image>

                <Label Margin="10,137,10,0"
                       HorizontalContentAlignment="Center"
                       Content="A message has been sent to your email."
                       VerticalAlignment="Top"/>

                <Label Content="Enter code:"
                       Margin="10,161,10,0"
                       VerticalAlignment="Top"/>

                <TextBox x:Name="TbCode"
                         Height="23"
                         Margin="10,185,10,0"
                         TextWrapping="Wrap"
                         Text=""
                         VerticalAlignment="Top"
                         KeyUp="SetCode"
                         LostFocus="SetCode"/>

                <Label x:Name="LTimer"
                       Margin="10,213,10,0"
                       HorizontalContentAlignment="Center"
                       Content="A second message can be sent after 60 seconds"
                       VerticalAlignment="Top"
                       FontSize="12"/>

                <Button x:Name="BSendMessage"
                        IsEnabled="False"
                        Width="200px"
                        Height="25"
                        Content="Send Message"
                        Margin="46,235,54,43.2"
                        Click="SendMail"/>

                <Label Content="Back"
                       Margin="10,273,10,0"
                       VerticalAlignment="Top"
                       Foreground="#FF673AB7"
                       FontSize="10"
                       MouseDown="OpenLogin"
                       Cursor="Hand"
                       HorizontalAlignment="Left"
                       Width="50"/>
            </Grid>
        </Border>
    </Grid>
</Page>