<Page x:Class="RegIN_Matckevich_Alikin.Pages.PinCode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:RegIN_Matckevich_Alikin.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PinCode">

    <Grid>
        <Border Height="304"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Width="307"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
            <Border.Effect>
                <DropShadowEffect Color="Black" ShadowDepth="2" BlurRadius="10" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Image HorizontalAlignment="Center"
                       Height="100"
                       Margin="32"
                       VerticalAlignment="Top"
                       Width="100"
                       Source="/Images/ic-user.png">
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50, 50"/>
                    </Image.Clip>
                </Image>
                <Label x:Name="LTitle"
                       Margin="10,137,10,0"
                       HorizontalContentAlignment="Center"
                       Content="Pin 4"
                       VerticalAlignment="Top"/>
                <Label Content="Введите PIN-код"
                       Margin="10,161,10,0"
                       VerticalAlignment="Top"/>
                <PasswordBox x:Name="TbPin"
                             Margin="10,185,10,0"
                             VerticalAlignment="Top"
                             Height="23"
                             MaxLength="4"
                             PreviewTextInput="InputDigit"
                             KeyUp="EnterPin"/>
                <Label x:Name="LMessage"
                       Margin="10,213,10,0"
                       VerticalAlignment="Top"
                       HorizontalContentAlignment="Center"
                       Content=""
                       FontSize="12"/>
                <Button x:Name="BSave"
                        Width="120"
                        Content="Войти"
                        Margin="10,243,10,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Height="25"
                        Click="EnterPin"/>
                <Button x:Name="BSkip"
                        Width="120"
                        Content="Назад"
                        Margin="10,243,22,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Height="25"
                        Click="Skip"/>
            </Grid>
        </Border>
    </Grid>
</Page>
